{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "midi-mapping (dj-mixer factory preset, clean-room)",
  "description": "Formato propio. No copiar XMLs de Serato al repo; convertir desde la copia local de referencia.",
  "type": "object",
  "required": ["format", "device", "bindings"],
  "properties": {
    "format": { "const": "djmixer-midi/1" },
    "device": {
      "type": "object",
      "required": ["vendorId", "productId", "midiName"],
      "properties": {
        "vendorId": { "type": "string", "example": "0x1AA1" },
        "productId": { "type": "string", "example": "0x0220" },
        "midiName": { "type": "string", "example": "VCI-100MKII DJ-Controller" },
        "matchSubstrings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "control", "eventType", "action"],
        "properties": {
          "channel": { "type": "integer", "minimum": 1, "maximum": 16 },
          "control": { "type": "integer", "minimum": 0, "maximum": 127 },
          "eventType": { "enum": ["NoteOn", "ControlChange"] },
          "action": { "type": "string", "description": "Ver contracts/aci-lite.md" },
          "deckId": { "type": "integer", "minimum": -1, "maximum": 3 },
          "conditions": { "type": "array", "items": { "type": "string" } },
          "translation": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["toggle_on_down", "explicit_range", "relative_center_0x40"] },
              "inMin": { "type": "number" },
              "inMax": { "type": "number" },
              "outMin": { "type": "number" },
              "outMax": { "type": "number" },
              "deadzone": { "type": "integer" },
              "reversed": { "type": "boolean" },
              "jogGain": { "type": "number" }
            }
          },
          "output": {
            "type": "object",
            "properties": {
              "feedback": { "type": "boolean" },
              "onValue": { "type": "integer", "const": 127 },
              "offValue": { "type": "integer", "const": 0 }
            }
          }
        }
      }
    }
  }
}
